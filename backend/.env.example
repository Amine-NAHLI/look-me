NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://lookme:lookme@127.0.0.1:5432/lookme?schema=public
JWT_ACCESS_SECRET=replace-with-a-generated-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-generated-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
MAX_UPLOAD_SIZE=5242880
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10
TRUST_PROXY=false
JSON_BODY_LIMIT=100kb
# Configure all three values together to enable Cloudinary uploads.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Configure all SMTP values together to enable password reset emails.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
